# Environment Configuration for Low-Latency Order Book Engine
# Copy this file to .env and adjust values as needed

# Build Configuration
CMAKE_BUILD_TYPE=Release
CMAKE_CXX_STANDARD=20
ENABLE_TESTS=ON
ENABLE_BENCHMARKS=ON
ENABLE_APPS=ON

# Sanitizer Configuration
ENABLE_ASAN=OFF
ENABLE_UBSAN=OFF
ENABLE_TSAN=OFF
ENABLE_COVERAGE=OFF

# Logging Configuration
SPDLOG_LEVEL=info
SPDLOG_PATTERN=[%Y-%m-%d %H:%M:%S.%e] [%^%l%$] [%t] %v

# Performance Configuration
MEMORY_POOL_SIZE=1000000
ARENA_ALLOCATOR_SIZE=1048576
ENABLE_METRICS=ON
METRICS_UPDATE_INTERVAL_MS=1000

# Risk Management Configuration
MAX_POSITION_PER_SYMBOL=1000000
MAX_ORDER_SIZE=100000
MAX_DAILY_VOLUME=10000000
ENABLE_SELF_TRADE_PREVENTION=ON
ENABLE_CIRCUIT_BREAKER=ON

# Network Configuration (for service deployment)
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT_MS=5000

# Testing Configuration
TEST_TIMEOUT_SECONDS=300
BENCHMARK_ITERATIONS=1000
FUZZ_TEST_DURATION_SECONDS=60

# Development Configuration
ENABLE_DEBUG_SYMBOLS=OFF
ENABLE_PROFILING=OFF
ENABLE_VERBOSE_LOGGING=OFF

# Language Binding Configuration
GO_BUILD_TAGS=
RUST_FEATURES=
PYTHON_TEST_COVERAGE=ON